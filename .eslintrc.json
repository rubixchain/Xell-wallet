{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": ["eslint:recommended"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-console": ["error", { "allow": ["warn", "error"] }],
    "no-inline-comments": "error",
    "no-warning-comments": [
      "error",
      { "terms": ["todo", "fixme"], "location": "anywhere" }
    ],
    "no-secrets/no-secrets": "error"
  },
  "plugins": ["no-secrets"]
}